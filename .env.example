# Vectural settings (prefix VECTURAL_, read by backend/config.py).
# Copy to .env — docker compose auto-loads it for variable substitution.

# --- Docker: serve/index YOUR real estate (leave unset for the sample-estate demo) ---
# Absolute host path to the estate root (mounted read-only at /estate in the containers).
#VECTURAL_ESTATE_HOST_PATH=/abs/path/to/your/estate
# Backing: "inmemory" (demo) or "real" (OpenSearch + Neo4j + Postgres).
#VECTURAL_BACKING=real
# Embedder: "hashing" (offline stand-in) or "bge-m3" (real BGE-M3; downloads once to hf-cache).
#VECTURAL_EMBEDDER=bge-m3
# LLM gateway: "fake" (canned) or "real" — real needs YOUR own client (design §2):
#VECTURAL_GATEWAY=real
#VECTURAL_GATEWAY_CLIENT=your_pkg.module:YourGatewayClient

# Estate paths for local (non-Docker) runs. In Docker these are fixed to /estate.
VECTURAL_ESTATE_ROOT=sample-estate
VECTURAL_MANIFEST_PATH=sample-estate/manifest.yaml

# Run tiers 1-4 summarisation on boot (fake gateway — no real spend) so coverage
# and review have content. Set false for a faster, retrieval-only boot.
VECTURAL_SUMMARISE_ON_BOOT=true

# Origins allowed to call the API directly (the Vite dev server).
VECTURAL_CORS_ORIGINS=["http://localhost:5175","http://localhost:5173"]

# --- Datastore connections (for the config-gated real adapters; unused by the
# --- in-memory bootstrap). Provisioned by docker-compose.
VECTURAL_POSTGRES_DSN=postgresql://vectural:vectural@localhost:5432/vectural
VECTURAL_VALKEY_URL=redis://localhost:6379/0
VECTURAL_OPENSEARCH_URL=http://localhost:9200
VECTURAL_NEO4J_URI=bolt://localhost:7687
